<Window x:Name="frmMain" x:Class="InfiniteMouse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:model="clr-namespace:InfiniteMouse.Model"
        xmlns:local="clr-namespace:InfiniteMouse"

        mc:Ignorable="d"
        Title="InfiniteMouse" Height="450" Width="313" Loaded="frmMain_Loaded" Icon="pack://application:,,,/Img/InfiniteMouse.png" Closing="frmMain_Closing" Background="#FF130C13" ResizeMode="NoResize" SizeToContent="WidthAndHeight" Closed="frmMain_Closed" Activated="frmMain_Activated">

    <Grid x:Name="grdMain" Margin="10,10,10,10">
        <GroupBox Header="Disposition détectée" Height="171" VerticalAlignment="Top" BorderBrush="White" Foreground="White" Margin="10,45,10,0">
            <Canvas x:Name="ScreenCanvas" Height="147" Width="251" Margin="5,0,7,0"/>
        </GroupBox>

        <model:RoundButton x:Name="btnChangerEtat" CornerRadius="10" Height="27" Neon="True" NeonRadius="5" NeonColor="#FF6D8090" Content="Activer" Margin="13,10,0,0" Background="#FF272727" Foreground="#FFD8CECE" Click="btnChangerEtat_Click" HorizontalAlignment="Left" Width="138" VerticalAlignment="Top" FontSize="14" BorderThickness="1,1,1,1" />
        <Grid x:Name="grdEtat" Margin="0,0,10,0" HorizontalAlignment="Right" Width="95" Height="38" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70*"/>
                <ColumnDefinition Width="27*"/>
            </Grid.ColumnDefinitions>
            <Label x:Name="lblEtat" Content="Désactivé" HorizontalAlignment="Center" Margin="0,11,0,0" VerticalAlignment="Top" Foreground="White" FontSize="14" HorizontalContentAlignment="Right"/>
            <model:RoundButton x:Name="btnLED" Content=""  Neon="True" NeonColor="Red" Background="Red" CornerRadius="100" Height="10" Width="10" VerticalAlignment="Top" Margin="8,21,0,0" HorizontalAlignment="Left" RenderTransformOrigin="0.517,0.521" Grid.Column="1" IsEnabled="False" BorderBrush="{x:Null}"/>

        </Grid>
        <model:CheckBoxCustom x:Name="chkSystemeTray" CornerRadius="2" IsChecked="{Binding SystemeTray}" Content="La fermeture ne ferme pas l'application." HorizontalAlignment="Left" Margin="17,237,0,0" VerticalAlignment="Top" Foreground="White" Width="223" FontSize="11" Background="White"/>
        <!--<CheckBox x:Name="chkWindows" Content="Démarre avec Windows." IsEnabled="False" IsChecked="{Binding DemarrageAvecWindows}" HorizontalAlignment="Left" Margin="17,240,0,0" VerticalAlignment="Top" Foreground="White" Width="151" FontSize="11" Checked="chkWindows_Checked"/>-->
        <model:CheckBoxCustom x:Name="chkActiver" CornerRadius="2" Content="Démarre Activer." IsChecked="{Binding DemarrageActiver}" HorizontalAlignment="Left" Margin="17,221,0,0" VerticalAlignment="Top" Foreground="White" Width="113" FontSize="11"/>


        <model:RoundButton x:Name="btnReload" CornerRadius="7" Neon="True" NeonRadius="5" NeonColor="AliceBlue" Background="#FF272727" Height="30" Margin="0,221,12,0" VerticalAlignment="Top" Click="btnReload_Click" ToolTip="Reload les écrans." HorizontalAlignment="Right" Width="30" BorderBrush="{x:Null}" >
            <Image x:Name="imgReload" Source="pack://application:,,,/Img/reload.png" Stretch="Uniform" Height="25" Width="25" d:RenderOptions.BitmapScalingMode="LowQuality" RenderOptions.BitmapScalingMode="HighQuality"></Image>
        </model:RoundButton>
        <Label Content="V0.0.1" HorizontalAlignment="Left" Foreground="#FF636363" Margin="253,38,0,0" VerticalAlignment="Top" FontSize="7" Width="30"/>


    </Grid>
</Window>
